# Pin assignments from Jacquard FPGA Studio.
# Edit this file, or the pin table on the Build screen: they are two views of one thing.
# Uploading the .zip this came in restores the pins, the board and the design top.
# jacquard-board: upduino-v3.1
# jacquard-top: motorcontroller
set_io -nowarn alpha_enable 26
set_io -nowarn beta_enable 9
set_io -nowarn delta_enable 32
set_io -nowarn enable 34
set_io -nowarn gamma_enable 10
set_io -nowarn motor_vector[0] 6
set_io -nowarn motor_vector[1] 11
set_io -nowarn motor_vector[2] 23
set_io -nowarn motor_vector[3] 21
set_io -nowarn motor_vector[4] 3
set_io -nowarn motor_vector[5] 44
set_io -nowarn motor_vector[6] 46
set_io -nowarn motor_vector[7] 45
set_io -nowarn reset 43
